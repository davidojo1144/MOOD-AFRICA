# Copy to .env and adjust. Only EXPO_PUBLIC_* vars are exposed to the app bundle.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=https://jsonplaceholder.typicode.com
EXPO_PUBLIC_API_TIMEOUT=15000
# When true, auth endpoints are mocked locally so the app works without a backend.
EXPO_PUBLIC_USE_MOCK_AUTH=true

# Build-time only (not bundled)
EXPO_OWNER=
EAS_PROJECT_ID=
